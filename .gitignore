# Godot 4+ specific ignores
.godot/
/android/

# Secrets — never commit API keys (Retro Diffusion etc.)
.env
*.env
!.env.example

# Art pipeline intermediates (raw generator output is regenerable from art/prompts/)
art/raw/*
!art/raw/.gitkeep

# Exports
/Exports/
*.tmp

# Art previews (regenerable: python3 art/tools/preview.py)
art/preview/*
!art/preview/.gitkeep

# Python bytecode from the art tools
__pycache__/
*.pyc

# A worktree's own user:// (config/custom_user_dir_name), so parallel test runs cannot share a
# save slot or a settings file. Local by definition; never commit one.
override.cfg

# Parallel agent worktrees, and the marker that keeps Godot from scanning them as part of
# this project (a second copy of every class_name would shadow the real ones).
.claude/worktrees/
.claude/.gdignore

# Playtest kit (docs/playtest-plan.md). The build stamp is written by
# tools/make_playtest_build.ps1 for one export and deleted after it; an uploader config holds
# an endpoint and possibly a key, and never belongs in the repository.
Data/build_stamp.txt
playtest.cfg
