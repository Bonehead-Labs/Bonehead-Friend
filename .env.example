# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# Retro Diffusion API key (https://www.retrodiffusion.ai — Account > API)
RD_API_KEY=rdpk-your-key-here

# NOTE: Claude Code's MCP config does not read this file. To make the key available
# to the Retro Diffusion MCP server, put it in ~/.claude/settings.json:
#
#   { "env": { "RD_API_KEY": "rdpk-..." } }
#
# ...then reference it as ${RD_API_KEY} in MCP config. (Retro Diffusion's own sample
# uses ${env:RD_API_KEY}, which is VS Code syntax and will NOT expand in Claude Code.)
# This .env exists for any local scripts that hit the REST API directly, which use the
# X-RD-Token header rather than the MCP's Bearer auth.
